{
  "name": "@fabric-vault/extension",
  "displayName": "FabricVault",
  "version": "0.0.4",
  "description": "A secure browser extension wallet for Hyperledger Fabric",
  "author": "ifeanyi ugwu <valentineifeanyiugwu@outlook.com>",
  "private": true,
  "scripts": {
    "dev": "plasmo dev",
    "build": "plasmo build",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test \"src/**/*.test.ts\"",
    "package": "plasmo package"
  },
  "dependencies": {
    "@fabric-vault/types": "workspace:*",
    "@noble/curves": "^1.9.0",
    "@plasmohq/messaging": "https://github.com/ifeanyi-ugwu/plasmo/releases/download/typed-messaging-pr1348/plasmohq-messaging-0.7.2.tgz",
    "@plasmohq/storage": "^1.13.0",
    "@tanstack/react-router": "^1.117.1",
    "@tanstack/router": "0.0.1-beta.53",
    "plasmo": "https://github.com/ifeanyi-ugwu/plasmo/releases/download/typed-messaging-pr1348/plasmo-0.90.5.tgz",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "webextension-polyfill": "^0.12.0"
  },
  "devDependencies": {
    "@grpc/grpc-js": "1.13.4",
    "@hyperledger/fabric-gateway": "1.10.1",
    "@hyperledger/fabric-protos": "0.3.7",
    "@ianvs/prettier-plugin-sort-imports": "4.1.1",
    "@types/node": "20.11.5",
    "@types/react": "18.2.48",
    "@types/react-dom": "18.2.18",
    "@types/webextension-polyfill": "^0.10.7",
    "prettier": "3.2.4",
    "tsx": "4.19.4",
    "typescript": "5.3.3"
  },
  "manifest": {
    "browser_specific_settings": {
      "gecko": {
        "id": "fabricvault@ifeanyiugwu",
        "data_collection_permissions": {
          "required": [
            "none"
          ]
        }
      }
    },
    "host_permissions": [
      "https://*/*",
      "http://*/*",
      "ws://*/*",
      "wss://*/*"
    ],
    "permissions": [
      "storage",
      "activeTab"
    ]
  }
}
